set(jolt_version v5.7.0)
cmake_host_system_information(RESULT os QUERY OS_NAME)
cmake_host_system_information(RESULT arch QUERY OS_PLATFORM)
if(CMAKE_HOST_APPLE)
    set(os macos)
elseif(CMAKE_HOST_WIN32)
    set(os windows)
endif()
string(TOLOWER "${os}-${arch}-release" jolt_platform)
set(jolt_install_dir "ThirdParty/JoltPhysics/${jolt_version}/${jolt_platform}")
